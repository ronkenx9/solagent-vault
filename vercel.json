{
    "version": 2,
    "name": "solagent-vault",
    "builds": [
        {
            "src": "packages/vault-api/src/server.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "packages/dashboard/public/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/vault/events",
            "dest": "packages/vault-api/src/server.ts",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "src": "/vault/(.*)",
            "dest": "packages/vault-api/src/server.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/packages/dashboard/public/$1",
            "check": true
        },
        {
            "src": "/(.*)",
            "dest": "/packages/dashboard/public/index.html"
        }
    ]
}