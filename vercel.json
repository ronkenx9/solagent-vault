{
    "version": 2,
    "public": true,
    "name": "solagent-vault",
    "builds": [
        {
            "src": "packages/dashboard/public/**",
            "use": "@vercel/static"
        },
        {
            "src": "packages/vault-api/src/server.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/vault/(.*)",
            "dest": "packages/vault-api/src/server.ts"
        },
        {
            "src": "/(.*)",
            "dest": "packages/dashboard/public/$1",
            "check": true
        },
        {
            "src": "/(.*)",
            "dest": "packages/dashboard/public/index.html"
        }
    ]
}