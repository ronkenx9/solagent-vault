# SolAgent Vault - Environment Variables

# REQUIRED: Master seed for HD wallet derivation
# Generate with: pnpm generate-seed
VAULT_MASTER_SEED=""

# REQUIRED: LLM API Key (choose one)
# For OpenAI (GPT-4o)
OPENAI_API_KEY=""

# OR for Anthropic (Claude)
# ANTHROPIC_API_KEY=""

# Optional: Solana RPC URL (devnet default)
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Optional: Ports
DASHBOARD_PORT=3000
VAULT_API_PORT=3001
