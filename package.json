{
  "name": "solagent-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Wallet Infrastructure for AI Agents on Solana",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter ./packages/* build",
    "dev": "pnpm --parallel run dev",
    "test": "pnpm --filter ./packages/* test",
    "vault": "pnpm --filter @solagent/vault-core dev",
    "vault-api": "pnpm --filter @solagent/vault-api dev",
    "orchestrator": "pnpm --filter @solagent/orchestrator dev",
    "dashboard": "pnpm --filter @solagent/dashboard dev",
    "generate-seed": "pnpm --filter @solagent/shared generate-seed"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}